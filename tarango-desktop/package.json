{
  "name": "tarango-desktop",
  "version": "1.0.0",
  "description": "Tarango — Lightweight IPTV Desktop Player",
  "homepage": "https://github.com/shahriar-ahmed-seam/IPTV-lite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": "Tarango",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "hls.js": "^1.5.0"
  },
  "build": {
    "appId": "com.lean.tarango",
    "productName": "Tarango",
    "copyright": "Copyright © 2026 Tarango",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/splash_image.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tarango IPTV"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video;AudioVideo;",
      "executableArgs": [
        "--no-sandbox"
      ],
      "icon": "assets/icons",
      "maintainer": "Tarango <shahriarseam17@gmail.com>",
      "synopsis": "Tarango IPTV Player",
      "description": "Tarango — Lightweight IPTV Desktop Player",
      "desktop": {
        "Name": "Tarango",
        "GenericName": "IPTV Player",
        "Comment": "Tarango — Lightweight IPTV Desktop Player",
        "Categories": "AudioVideo;Video;Player;TV;"
      }
    }
  }
}
